/*
  TFT Image Converter - Arduino Example
  -------------------------------------

  This example demonstrates how to display an image generated by
  TFT-Image-Converter on an Arduino-compatible microcontroller.

  This example uses:

    - Arduino-compatible board
    - ST7735 TFT display
    - Adafruit GFX Library
    - Adafruit ST7735 Library
    - RGB565 image data generated by TFT-Image-Converter


  The converter generates an "image.h" file containing the image
  as a C/C++ uint16_t array.

  Example project structure:

      Arduino_Example/
      ├── Arduino_Example.ino
      └── image.h


  RGB565:
  --------

  RGB565 stores each pixel using 16 bits (2 bytes).

      Red   = 5 bits
      Green = 6 bits
      Blue  = 5 bits


  A 128x160 image therefore requires:

      128 × 160 × 2 = 40,960 bytes
      ≈ 40 KB


  Libraries:
  ----------

  Adafruit GFX Library:
  https://github.com/adafruit/Adafruit-GFX-Library

  Adafruit ST7735 Library:
  https://github.com/adafruit/Adafruit-ST7735-Library


  IMPORTANT:
  ----------

  The pin definitions below are examples.

  Different Arduino boards and TFT modules may use different
  pins. Check your TFT module's documentation before wiring it.

  This example assumes an SPI-based ST7735 display.
*/

#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include <SPI.h>

#include "image.h"


/*
  TFT pin configuration.

  Change these pins to match your Arduino board.

  TFT_CS:
    Chip Select

  TFT_DC:
    Data/Command

  TFT_RST:
    Reset
*/
#define TFT_CS   10
#define TFT_DC    9
#define TFT_RST   8


/*
  Create the ST7735 display object.

  The display communicates with the Arduino using SPI.
*/
Adafruit_ST7735 tft = Adafruit_ST7735(
  TFT_CS,
  TFT_DC,
  TFT_RST
);


/*
  Image dimensions.

  These values must match the image dimensions generated
  by TFT-Image-Converter.
*/
#define IMAGE_WIDTH  128
#define IMAGE_HEIGHT 160


/*
  RGB565 images can be sent directly to the display.

  However, byte order depends on the display controller
  and the library being used.

  The helper function below sends the high byte followed
  by the low byte for every pixel.
*/
void drawRGB565Image(
  int16_t x,
  int16_t y,
  const uint16_t *data,
  uint16_t width,
  uint16_t height
)
{
  /*
    Set the drawing window on the TFT.

    All following pixel data will be written into this area.
  */
  tft.setAddrWindow(
    x,
    y,
    x + width - 1,
    y + height - 1
  );


  /*
    Start sending pixel data.

    CS is controlled by the Adafruit ST7735 library.
  */
  uint32_t pixelCount = (uint32_t)width * height;


  for (uint32_t i = 0; i < pixelCount; i++)
  {
    /*
      Read one RGB565 pixel from the image array.
    */
    uint16_t pixel = data[i];


    /*
      Send the high byte first.
    */
    SPI.transfer(pixel >> 8);


    /*
      Send the low byte second.
    */
    SPI.transfer(pixel & 0xFF);
  }
}


void setup()
{
  /*
    Initialize the TFT display.

    The initialization command depends on the
    ST7735 display variant.

    INITR_BLACKTAB is commonly used by 1.8" ST7735
    displays, but your module may require another
    initialization option.
  */
  tft.initR(INITR_BLACKTAB);


  /*
    Set the display rotation.

      0 = portrait
      1 = landscape
      2 = portrait (flipped)
      3 = landscape (flipped)
  */
  tft.setRotation(0);


  /*
    Clear the display.
  */
  tft.fillScreen(ST77XX_BLACK);


  /*
    Display the converted image.

    The image array comes from image.h.
  */
  drawRGB565Image(
    0,
    0,
    image,
    IMAGE_WIDTH,
    IMAGE_HEIGHT
  );
}


void loop()
{
  /*
    Nothing else is required.

    The image remains on the TFT after it has been drawn.
  */
}
