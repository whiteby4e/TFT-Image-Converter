```cpp
/*
  TFT Image Converter - ESP32 Example
  -----------------------------------

  This example demonstrates how to display an image generated by
  TFT-Image-Converter on an ESP32 with a TFT display.

  The converter generates an "image.h" file containing the image
  as an RGB565 uint16_t array.

  This example uses:
    - ESP32
    - TFT_eSPI library
    - ST7735-based TFT display

  IMPORTANT:
  Before compiling this example, make sure TFT_eSPI is configured
  correctly for your TFT display in User_Setup.h.

  The generated image.h file should be placed in the same folder
  as this Arduino sketch.

  Example project structure:

      ESP32_Example/
      ├── ESP32_Example.ino
      └── image.h


  RGB565:
  --------
  TFT displays commonly use RGB565 because it stores each pixel
  using only 16 bits (2 bytes).

      Red   = 5 bits
      Green = 6 bits
      Blue  = 5 bits

  For a 128x160 image:

      128 × 160 × 2 = 40,960 bytes
      ≈ 40 KB


  Reference:
  ----------
  TFT_eSPI library by Bodmer:
  https://github.com/Bodmer/TFT_eSPI

  TFT_eSPI documentation and examples:
  https://github.com/Bodmer/TFT_eSPI/tree/master/examples
*/

#include <TFT_eSPI.h>
#include "image.h"

// Create the TFT display object.
TFT_eSPI tft = TFT_eSPI();


// Image dimensions.
//
// These values must match the dimensions used by the converter.
#define IMAGE_WIDTH  128
#define IMAGE_HEIGHT 160


void setup()
{
  /*
    Initialize the TFT display.

    TFT_eSPI uses the hardware configuration defined in
    User_Setup.h.
  */
  tft.init();


  /*
    Set the display rotation.

    Rotation values:
      0 = portrait
      1 = landscape
      2 = portrait (flipped)
      3 = landscape (flipped)

    Change this value if your display orientation is different.
  */
  tft.setRotation(0);


  /*
    RGB565 byte order.

    The converter generates RGB565 pixel values.
    setSwapBytes(true) is commonly required when using
    pushImage() with image data stored in a C/C++ array.
  */
  tft.setSwapBytes(true);


  /*
    Clear the display before drawing the image.
  */
  tft.fillScreen(TFT_BLACK);


  /*
    Draw the complete image.

    Parameters:

      0             = X position
      0             = Y position
      IMAGE_WIDTH   = image width
      IMAGE_HEIGHT  = image height
      image         = RGB565 image array from image.h
  */
  tft.pushImage(
    0,
    0,
    IMAGE_WIDTH,
    IMAGE_HEIGHT,
    image
  );
}


void loop()
{
  /*
    Nothing is required here.

    The image is already stored in the ESP32's program flash
    memory and was drawn during setup().
  */
}
```
